<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) || "Campus" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Campus">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (remember to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# layui 必须在前，:app 在后，application.css 里的主题覆盖才生效 %>
    <%= stylesheet_link_tag "layui/css/layui", "data-turbo-track": "reload" %>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>

  <body class="layui-layout-body">
    <div class="layui-layout layui-layout-admin<%= " campus-no-side" unless logged_in? %>">
      <%# 白顶栏：设计图里左边只有折叠图标、右边是营业状态胶囊和门店胶囊；
          栏目名不在顶栏，改由内容区标题条承担（见 main 里的 campus-page-title） %>
      <header class="layui-header">
        <ul class="layui-nav layui-layout-right">
          <% if logged_in? %>
            <% if current_user.shop %>
              <li class="layui-nav-item">
                <span class="campus-status-pill <%= current_user.shop.status ? "is-open" : "is-closed" %>">
                  <i class="campus-status-dot"></i><%= current_user.shop.status ? "营业中" : "已停业" %>
                </span>
              </li>
            <% end %>
            <li class="layui-nav-item">
              <span class="campus-shop-chip">
                <%= image_tag "/icon.png", class: "campus-shop-avatar", alt: "" %>
                <span><%= current_user.shop&.name || current_user.display_name %></span>
              </span>
            </li>
            <li class="layui-nav-item">
              <%= button_to "退出", logout_path, method: :delete,
                    class: "campus-logout", form_class: "campus-logout-form" %>
            </li>
          <% end %>
        </ul>
      </header>

      <% if logged_in? %>
        <aside class="layui-side campus-side">
          <%= link_to "Campus", root_path, class: "campus-brand" %>

          <div class="layui-side-scroll">
            <ul class="layui-nav layui-nav-tree">
              <li class="layui-nav-item<%= " layui-this" if current_page?(root_path) %>">
                <%= link_to root_path do %><i class="layui-icon layui-icon-console"></i>控制台<% end %>
              </li>
              <%# /shops 已收为管理员专属管理台，非管理员不给入口 %>
              <% if current_user.admin? %>
                <li class="layui-nav-item<%= " layui-this" if controller_name == "shops" %>">
                  <%= link_to shops_path do %><i class="layui-icon layui-icon-home"></i>门店管理<% end %>
                </li>
              <% end %>
              <%# 没有门店的账号点进去只会被弹回控制台，入口跟着收起来；营业时间页也算我的店铺这一段 %>
              <% if current_user.shop %>
                <li class="layui-nav-item<%= " layui-this" if controller_name == "my_shops" || controller_name == "business_hours" %>">
                  <%= link_to edit_my_shop_path do %><i class="layui-icon layui-icon-location"></i>我的店铺<% end %>
                </li>
              <% end %>
              <li class="layui-nav-item<%= " layui-this" if controller_name == "categories" %>">
                <%= link_to categories_path do %><i class="layui-icon layui-icon-app"></i>菜品分类<% end %>
              </li>
              <li class="layui-nav-item<%= " layui-this" if controller_name == "goods" %>">
                <%= link_to goods_path do %><i class="layui-icon layui-icon-cart"></i>菜品管理<% end %>
              </li>
              <% if current_user.admin? %>
                <li class="layui-nav-item<%= " layui-this" if controller_path == "admin/users" %>">
                  <%= link_to admin_users_path do %><i class="layui-icon layui-icon-user"></i>用户管理<% end %>
                </li>
                <li class="layui-nav-item<%= " layui-this" if current_page?(admin_root_path) %>">
                  <%= link_to admin_root_path do %><i class="layui-icon layui-icon-set"></i>管理后台<% end %>
                </li>
              <% end %>
            </ul>
          </div>
        </aside>
      <% end %>

      <main class="layui-body campus-body">
        <%# 设计图的排版：灰底内容区顶部一条栏目名标题条，下面整块白面板承载页面 %>
        <% if logged_in? %>
          <div class="campus-page-title"><%= current_section_title %></div>
        <% end %>
        <% flash.each do |type, message| %>
          <div class="campus-flash campus-flash-<%= type %>">
            <i class="layui-icon <%= type.to_s == "alert" ? "layui-icon-close-fill" : "layui-icon-ok-circle" %>"></i>
            <span><%= message %></span>
          </div>
        <% end %>
        <% if logged_in? %><div class="campus-page-panel"><% end %>
        <%= yield %>
        <% if logged_in? %></div><% end %>
      </main>
    </div>

    <%= javascript_include_tag "layui/layui", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload" %>
    <%= yield :page_scripts %>
  </body>
</html>

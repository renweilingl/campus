<% content_for(:title, "用户管理") %>

<div class="campus-page-head">
  <%= link_to "新增用户", new_admin_user_path, class: "layui-btn" %>
</div>

<% if @users.any? %>
  <table class="layui-table">
    <thead>
      <tr>
        <th>手机号</th>
        <th>昵称</th>
        <th>角色</th>
        <th>状态</th>
        <th>门店</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td><%= link_to user.phone, edit_admin_user_path(user) %></td>
          <td><%= user.nickname.presence || "—" %></td>
          <td>
            <% if user.admin? %>
              <span class="layui-badge layui-bg-blue">admin</span>
            <% else %>
              <span class="layui-badge-rim">user</span>
            <% end %>
          </td>
          <td>
            <% if user.enabled? %>
              <span class="layui-badge layui-bg-green">启用</span>
            <% else %>
              <span class="layui-badge-rim">禁用</span>
            <% end %>
          </td>
          <td><%= user.shop&.name || "—" %></td>
          <td>
            <%= link_to "编辑", edit_admin_user_path(user), class: "layui-btn layui-btn-xs layui-btn-primary" %>
            <%# 不能把自己禁掉，入口对当前登录账号收起来 %>
            <% unless user.id == current_user.id %>
              <%= button_to user.enabled? ? "禁用" : "启用", toggle_status_admin_user_path(user),
                    method: :patch,
                    class: "layui-btn layui-btn-xs #{user.enabled? ? "layui-btn-warm" : ""}",
                    form_class: "campus-inline-form" %>
              <%# 名下有门店的账号只能禁用不能删除（删了会连带删店），入口收起来、控制器再兜一层 %>
              <% if user.shop.nil? %>
                <%= button_to "删除", admin_user_path(user), method: :delete,
                      class: "layui-btn layui-btn-xs layui-btn-danger",
                      form_class: "campus-inline-form",
                      onclick: "return confirm('确认删除该用户？')" %>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="layui-card">
    <div class="layui-card-body campus-empty">
      还没有用户，<%= link_to "新增第一个用户", new_admin_user_path %>。
    </div>
  </div>
<% end %>

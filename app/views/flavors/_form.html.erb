<%= form_with model: [ @good, @group, @flavor ], class: "layui-form" do |form| %>
  <div class="layui-form-item">
    <%= form.label :name, "口味名称", class: "layui-form-label" %>
    <div class="layui-input-block">
      <%= form.text_field :name, class: "layui-input", required: true, maxlength: 20,
            placeholder: "如 微辣 / 加蛋" %>
      <%= render "shared/field_errors", errors: @flavor.errors[:name] %>
    </div>
  </div>

  <div class="layui-form-item">
    <%= form.label :price_in_yuan, "加价（元）", class: "layui-form-label" %>
    <div class="layui-input-block">
      <%= form.text_field :price_in_yuan, type: :number, step: "0.01", min: "0", class: "layui-input" %>
      <div class="layui-word-aux">默认 0 元，即不加价</div>
      <%= render "shared/field_errors", errors: @flavor.errors[:price] %>
    </div>
  </div>

  <div class="layui-form-item">
    <%= form.label :recommend, "排序", class: "layui-form-label" %>
    <div class="layui-input-block">
      <%= form.number_field :recommend, min: "0", step: "1", class: "layui-input" %>
      <div class="layui-word-aux">数字越大越靠前</div>
      <%= render "shared/field_errors", errors: @flavor.errors[:recommend] %>
    </div>
  </div>

  <div class="layui-form-item">
    <div class="layui-input-block">
      <%= form.submit "保存", class: "layui-btn" %>
      <%= link_to "取消", good_flavor_group_flavors_path(@good, @group), class: "layui-btn layui-btn-primary" %>
    </div>
  </div>
<% end %>

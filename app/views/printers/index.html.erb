<% content_for(:title, "打印机管理") %>

<div class="campus-page-head">
  <%= link_to "新增打印机", new_printer_path, class: "layui-btn" %>
</div>

<% if @printers.any? %>
  <table class="layui-table">
    <thead>
      <tr>
        <th>品牌</th>
        <th>打印机名称</th>
        <th>打印机编码</th>
        <th>是否启用</th>
        <th>操作</th>
      </tr>
    </thead>
    <tbody>
      <% @printers.each do |printer| %>
        <tr>
          <td><%= printer.brand_label %></td>
          <td><%= link_to printer.name, edit_printer_path(printer) %></td>
          <td><%= printer.code %></td>
          <td>
            <%# 这一列只展示真实状态，改启用走编辑页，避免把动作文案当成状态读反 %>
            <% if printer.enabled? %>
              <span class="layui-badge layui-bg-green">启用</span>
            <% else %>
              <span class="layui-badge-rim">停用</span>
            <% end %>
          </td>
          <td>
            <%= link_to "编辑", edit_printer_path(printer), class: "layui-btn layui-btn-xs layui-btn-primary" %>
            <%= button_to "删除", printer_path(printer), method: :delete,
                  class: "layui-btn layui-btn-xs layui-btn-danger",
                  form_class: "campus-inline-form",
                  onclick: "return confirm('确认删除该打印机？')" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="layui-card">
    <div class="layui-card-body campus-empty">
      还没有打印机，<%= link_to "新增第一台打印机", new_printer_path %>。
    </div>
  </div>
<% end %>
